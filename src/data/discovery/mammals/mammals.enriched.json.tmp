    },
    "media": {
      "images": [
        "https://commons.wikimedia.org/wiki/Special:FilePath/Antilocapra%20americana.jpg?width=1000",
        "https://commons.wikimedia.org/wiki/Special:FilePath/Antilocapra%20americana%20female%20(Wyoming%2C%202012).jpg?width=1000"
